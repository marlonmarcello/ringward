{
  "name": "ringward",
  "version": "0.2.0",
  "description": "Elden Ring mod manager for ME3",
  "homepage": "https://github.com/marlonmarcello/ringward",
  "repository": "github:marlonmarcello/ringward",
  "author": "Ringward contributors",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "changeset": "changeset",
    "version:release": "changeset version && npm install --package-lock-only --ignore-scripts",
    "build:merge": "node scripts/build-merge.cjs",
    "build:unpacked": "npm run build:merge && electron-builder --win --dir",
    "build": "npm run build:merge && electron-builder --win nsis"
  },
  "dependencies": {
    "@sigstore/bundle": "5.0.1",
    "@sigstore/tuf": "5.0.1",
    "@sigstore/verify": "4.1.3",
    "semver": "7.8.2",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.ringward.manager",
    "productName": "Ringward",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "!src/ui/assets/{main,character-preset,reshade-preset,save-backup}.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".tools/merge",
        "to": "merge"
      }
    ],
    "win": {
      "icon": "src/ui/assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "Ringward-v${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false
    }
  },
  "overrides": {
    "@tufjs/models": {
      "minimatch": "11.0.1"
    }
  }
}
