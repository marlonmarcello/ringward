<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Ringward.Merge</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Andre.Core" HintPath="$(SmithboxDir)/Andre.Core.dll" Private="false" />
    <Reference Include="Andre.Formats" HintPath="$(SmithboxDir)/Andre.Formats.dll" Private="false" />
    <Reference Include="Andre.IO" HintPath="$(SmithboxDir)/Andre.IO.dll" Private="false" />
    <Reference Include="Andre.SoulsFormats" HintPath="$(SmithboxDir)/Andre.SoulsFormats.dll" Private="false" />
  </ItemGroup>
</Project>
